# TontaubeV1.1 Flash on the CPU: a small image without CUDA, vLLM or the TontaubeV1.1 models.
#
#   docker build -f Dockerfile.cpu -t tontaube-flash-cpu:1.2.0 .
#   docker run --rm -p 127.0.0.1:8080:8080 \
#     -v tontaube-cache:/root/.cache \
#     tontaube-flash-cpu:1.2.0
FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:0.10.0 /uv /usr/local/bin/uv

ENV TTS_MODEL=flash \
    LITE_DEVICE=cpu \
    TTS_HOST=0.0.0.0 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/srv \
    REQUIRE_API_KEY=0 \
    UV_SYSTEM_PYTHON=1 \
    UV_NO_CACHE=1 \
    TONTAUBE_CACHE_DIR=/opt/tontaube

# g++ builds the engine and the text front end; ffmpeg encodes MP3 and Opus for /predict.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg g++ libopus0 && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /srv
COPY requirements-pip.lock /srv/
# Only what the server needs for Flash, at the versions of the full lock file.
RUN uv pip install --constraint requirements-pip.lock \
    fastapi "uvicorn[standard]" pydantic numpy soundfile pydub lameenc opuslib huggingface-hub

COPY pyproject.toml README.md LICENSE NOTICE THIRD_PARTY_NOTICES /srv/
COPY VibeVoice/LICENSE /srv/VibeVoice/LICENSE
COPY voices/LICENSE /srv/voices/LICENSE
COPY app /srv/app
COPY flash /srv/flash
RUN uv pip install --no-deps /srv
# Built into the image (one library for every x86-64 CPU), so the server starts without compiling.
RUN python -c "from flash.cpu.engine import engine_library; from flash.common.frontend import text_library; engine_library(); text_library()"
COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD []
